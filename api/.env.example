# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000

# ── Database (Neon Postgres + PostGIS) ───────────────────────────────────────
DATABASE_URL=

# ── Redis (optional — free tier at upstash.com works). Without it the app
# falls back to an in-memory store: fine for one dev instance, not for
# production or multiple backend instances. ──────────────────────────────────
REDIS_URL=

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=30d
SESSION_COOKIE_NAME=kitabx_session
ADMIN_SESSION_COOKIE_NAME=kitabx_admin_session

# ── OTP delivery ─────────────────────────────────────────────────────────────
# With no SMS provider configured, OTPs are logged to the server console so
# the app is fully usable without any SMS account. Set SMS_PROVIDER=msg91
# (+ the MSG91_* vars) to send real SMS instead.
SMS_PROVIDER=console
# MSG91: authkey from Dashboard > API, template_id from the DLT-approved
# template you added under Dashboard > SMS > Flows. MSG91_TEMPLATE_VAR_NAME
# only needs setting if that template's variable isn't named "VAR1".
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_VAR_NAME=

# ── Email OTP (§13) — leave blank to log codes to the console instead of ────
# sending real email. Sends via Brevo's HTTPS API (never their SMTP relay —
# Render's outbound network can't reliably reach SMTP ports) — get a key at
# app.brevo.com → SMTP & API → API Keys. EMAIL_FROM must be a sender verified
# in Brevo (Senders, Domains & Dedicated IPs → Senders); verifying your own
# domain there (with the SPF/DKIM records Brevo gives you) is what actually
# keeps sends from being blocked or rate-limited — a personal Gmail/Yahoo/
# Outlook address relayed through any ESP gets rate-limited by that
# provider's own anti-spoofing rules regardless.
BREVO_API_KEY=
EMAIL_FROM=KitabX <no-reply@yourdomain.com>

# ── Firebase Admin (FCM push notifications only — not phone auth) ───────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Google/Apple sign-in (Task 32) — leave blank to keep those buttons ──────
# disabled (a clear 503 instead of a broken flow).
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Google Books (ISBN lookup / search). Works without a key at low volume;
# add one at console.cloud.google.com for higher quota. ─────────────────────
GOOGLE_BOOKS_API_KEY=

# ── Gemini (multi-book photo extraction) ─────────────────────────────────────
GEMINI_API_KEY=

# ── Cloudinary (book cover / condition photo storage). Get these from your
# Cloudinary dashboard (cloudinary.com/console). ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin bootstrap (creates one SUPER_ADMIN row on first `db:seed` run) ─────
# Admin login is phone+OTP only (no password) — set the real phone number here.
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_EMAIL=admin@kitabx.app
