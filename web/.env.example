# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.
# The app runs without any of these: service calls fail softly and screens fall
# back to the seed data in lib/mockData.js.

# NestJS API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Firebase — phone OTP login + FCM web push
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web-push VAPID key (Firebase Console → Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google/Apple sign-in (Task 32) — client IDs are public identifiers, safe to
# expose here. Leave blank to hide those buttons entirely (they only render
# once a real id is present, since neither works without one anyway).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Must exactly match the Services ID's "Return URLs" entry in Apple Developer.
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000/login
