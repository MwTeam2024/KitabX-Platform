# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.
# The app runs without any of these: service calls fail softly and screens fall
# back to the seed data in lib/mockData.js.

# NestJS API base URL (must include the /api/v1 prefix). Locally this points
# straight at the API; in production (frontend and API on different domains —
# Vercel + Render) it must instead be the *relative* path "/api/v1" so every
# request stays same-origin and gets silently proxied to BACKEND_API_URL below
# via next.config.mjs's rewrite — otherwise the session cookie is a
# third-party cookie and iOS Safari blocks it outright (Task 64).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Server-side only (no NEXT_PUBLIC_ prefix — never reaches the browser bundle).
# The real API origin next.config.mjs's rewrite forwards /api/v1/* to. Only
# set this in production; leave unset locally so the rewrite is a no-op and
# NEXT_PUBLIC_API_URL above is used directly instead.
BACKEND_API_URL=
# Socket.IO gateway origin (§14/§35/§46 — live chat + notifications) — no
# /api/v1 suffix, the gateway isn't behind the REST prefix. Without this set,
# the socket singleton no-ops and the app silently falls back to polling.
# Kept as a direct cross-origin connection in production (not proxied above —
# WebSocket rewrite support is less reliable), so if the notification socket
# itself ever needs the same third-party-cookie fix, that's follow-up work.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Firebase — phone OTP login + FCM web push
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web-push VAPID key (Firebase Console → Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google/Apple sign-in (Task 32) — client IDs are public identifiers, safe to
# expose here. Leave blank to hide those buttons entirely (they only render
# once a real id is present, since neither works without one anyway).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
# Must exactly match the Services ID's "Return URLs" entry in Apple Developer.
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000/login
